# YardWise environment variables. Copy to .env for local dev (compose) or see
# the k8s manifests for the cluster values (secrets come from Vault via ESO).

# --- Django core ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Leave unset for local dev (an ephemeral key is generated per start).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=yardwise.meklab.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://yardwise.meklab.net

# --- Database (unset POSTGRES_HOST to fall back to sqlite for quick hacking) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yardwise
POSTGRES_USER=yardwise
# Any throwaway value for the local compose db; the cluster value lives in Vault.
POSTGRES_PASSWORD=

# --- Photo storage (the Longhorn PVC mount in the cluster) ---
YARDWISE_MEDIA_ROOT=/data/media

# --- Authentik OIDC (issue #3; leave unset for local dev = admin login) ---
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=
# OIDC_BASE_URL=https://auth.meklab.net/application/o/yardwise
